# ---------- Secrets (never commit) ----------
.env
*.env
!.env.example
backend/.env

# ---------- Backend (CodeIgniter 4) ----------
backend/vendor/
backend/writable/cache/*
backend/writable/logs/*
backend/writable/session/*
backend/writable/uploads/*
backend/writable/debugbar/*
!backend/writable/**/index.html
!backend/writable/**/.gitkeep

# ---------- Frontend (Ionic / Angular, later phase) ----------
frontend/node_modules/
frontend/www/
frontend/dist/
frontend/.angular/
frontend/.sass-cache/
frontend/platforms/
frontend/plugins/

# ---------- Postman: never commit exported files containing real secrets ----------
postman/*.local.json

# ---------- OS / editor ----------
Thumbs.db
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log
