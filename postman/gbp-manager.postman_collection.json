{
  "info": {
    "name": "GBP Manager API",
    "description": "Local API tests. Set the environment 'GBP Local' before running. No real secrets belong in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Phase 0 - Health",
      "item": [
        {
          "name": "GET health (database check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectDown = pm.environment.get('expectDbDown') === 'true';",
                  "",
                  "pm.test(expectDown ? 'Status is 503 (database down expected)' : 'Status is 200', function () {",
                  "    pm.response.to.have.status(expectDown ? 503 : 200);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response has success, message and data', function () {",
                  "    pm.expect(body).to.have.property('success');",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('data');",
                  "});",
                  "",
                  "pm.test('success flag matches expectation', function () {",
                  "    pm.expect(body.success).to.eql(!expectDown);",
                  "});",
                  "",
                  "pm.test('database status matches expectation', function () {",
                  "    pm.expect(body.data.database.status).to.eql(expectDown ? 'down' : 'up');",
                  "});",
                  "",
                  "pm.test('service name is gbp-manager-api', function () {",
                  "    pm.expect(body.data.service).to.eql('gbp-manager-api');",
                  "});",
                  "",
                  "pm.test('No sensitive words in response', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    ['password', 'secret', 'token', 'gmb_app', 'stack'].forEach(function (w) {",
                  "        pm.expect(text).to.not.include(w);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        },
        {
          "name": "POST health (wrong method -> 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('POST is not allowed on a GET-only route (404)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        },
        {
          "name": "GET unknown path (-> 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown API path returns 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "does-not-exist"]
            }
          }
        }
      ]
    }
  ]
}