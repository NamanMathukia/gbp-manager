#--------------------------------------------------------------------
# GBP Manager backend - example environment file
# Copy this file to ".env" and fill in real values locally.
# Never put real secrets in this example file.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8090/'

database.default.hostname = localhost
database.default.database = gmb_management_db
database.default.username = gmb_app
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci